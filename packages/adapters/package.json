{
  "name": "@mandarin/adapters",
  "version": "0.1.0",
  "private": true,
  "description": "Ports (interfaces) and provider adapters. Mock adapters always return source=\"mock\". Depends on @mandarin/contracts only.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./artwork": {
      "types": "./dist/artwork/index.d.ts",
      "default": "./dist/artwork/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint src",
    "test": "vitest run",
    "fetch:handwriting-data": "node scripts/fetch-handwriting-data.mjs"
  },
  "dependencies": {
    "@mandarin/contracts": "workspace:*",
    "hanzilookup-js": "1.0.3"
  },
  "devDependencies": {
    "@mandarin/config": "workspace:*"
  }
}
