{
  "name": "@mandarin/domain",
  "version": "0.1.0",
  "private": true,
  "description": "Pure domain rules (no React Native, no network). Depends only on @mandarin/contracts.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@mandarin/contracts": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@mandarin/config": "workspace:*"
  }
}
