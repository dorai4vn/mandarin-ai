# apps/mobile — PUBLIC values only. Anything prefixed EXPO_PUBLIC_ is embedded in the app
# bundle and visible to users. Never put OpenAI/Azure keys or the Supabase service role here.

# Base URL of apps/api reachable from the iPhone (LAN IP of your Mac or a dev tunnel).
EXPO_PUBLIC_API_URL=http://192.168.1.10:8787

# Supabase project URL and publishable (anon) key — public by design, protected by RLS.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Build-time identifiers (owner decides; used by app.config.ts and EAS).
IOS_BUNDLE_IDENTIFIER=com.example.mandarinai.dev
EAS_PROJECT_ID=
