{
  "name": "@mandarin/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "lint": "eslint app src modules/digital-ink/index.ts app.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "expo export --platform ios --output-dir dist --no-minify",
