# apps/api — copy to apps/api/.env for local development. NEVER commit the real .env.
# All values are server-side secrets unless stated otherwise.

NODE_ENV=development
HOST=0.0.0.0
# Railway (candidate host) injects PORT automatically.
PORT=8787

# Supabase: URL is used to fetch the project's JWKS for verifying user access tokens.
SUPABASE_URL=http://127.0.0.1:54321
# Optional, local/legacy only: HS256 JWT secret. Leave empty when the project uses
# asymmetric signing keys (JWKS). Never set this in the mobile app.
SUPABASE_JWT_SECRET=

# Provider mode: when a provider key is missing, `mock` returns clearly labelled MOCK
# results (development only); `disabled` returns HTTP 503. Production forces `disabled`.
MISSING_PROVIDER_MODE=mock

# OpenAI (Realtime feasibility/auth spike, D-004)
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_TTL_SECONDS=600

# Azure AI Speech (pronunciation assessment, zh-CN)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia

# Basic abuse/cost guard: max provider calls per user per minute.
RATE_LIMIT_PER_MINUTE=20

# Browser origins of the web app allowed by CORS (comma-separated).
WEB_ORIGINS=http://localhost:3000

# Handwriting recognizer data (D-029): run `pnpm --filter @mandarin/adapters fetch:handwriting-data`
# then point to the file. Licence approval pending (GPL-3 matcher server-side, Arphic PL data).
HANDWRITING_DATA_PATH=../../packages/adapters/data/mmah.json

# Supabase Storage for private PDF uploads (server-only key; private bucket).
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=documents
