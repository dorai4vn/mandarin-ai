{
  "name": "@mandarin/api",
  "version": "0.1.0",
  "private": true,
  "description": "Mandarin AI backend API (Node.js + Fastify). Holds provider secrets; mobile never does.",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint src",
    "test": "vitest run",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@fastify/cors": "11.4.3",
    "@mandarin/adapters": "workspace:*",
    "@mandarin/contracts": "workspace:*",
    "fastify": "5.12.8",
    "jose": "6.2.18",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@mandarin/config": "workspace:*",
    "tsx": "4.23.15"
  }
}
