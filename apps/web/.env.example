# apps/web — PUBLIC values only. NEXT_PUBLIC_* is embedded in the JavaScript sent to browsers.
# Never put OpenAI/Azure keys or the Supabase service role key here.

# Base URL of apps/api reachable from the browser (HTTPS outside localhost).
NEXT_PUBLIC_API_URL=http://localhost:8787

# Supabase project (publishable/anon key is public by design; RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Development only: shows a field to paste an access token until login ships (M1).
NEXT_PUBLIC_ENABLE_DEV_TOKEN=false

# Development only: register the service worker under `next dev` (normally production only).
NEXT_PUBLIC_ENABLE_SW_IN_DEV=false
